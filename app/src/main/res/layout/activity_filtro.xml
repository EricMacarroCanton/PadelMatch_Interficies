<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backBlack"
    android:padding="16dp">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginBottom="12dp"
        android:background="@color/grey_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tituloFiltros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/filter_title"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

    <ImageButton
        android:id="@+id/btnCerrarFiltro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_cerrar"
        android:src="@drawable/cerrar"
        app:layout_constraintBottom_toBottomOf="@id/tituloFiltros"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tituloFiltros"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/lblSkillLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/filter_skill_level"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloFiltros" />

    <TextView
        android:id="@+id/badgeSkillRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/green_level_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/filter_skill_range_value"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/lblSkillLevel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/lblSkillLevel" />

    <TextView
        android:id="@+id/lblSkillDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/filter_skill_desc"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblSkillLevel" />

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/sliderSkillLevel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:valueFrom="1.0"
        android:valueTo="5.0"
        app:haloColor="@color/green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblSkillDesc"
        app:thumbColor="@color/green"
        app:trackColor="@color/grey_bg"
        app:trackColorActive="@color/green" />

    <TextView
        android:id="@+id/lblMinSkill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filter_min_skill"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sliderSkillLevel" />

    <TextView
        android:id="@+id/lblMaxSkill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filter_max_skill"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sliderSkillLevel" />

    <TextView
        android:id="@+id/lblCourtPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/filter_court_position"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblMinSkill" />

    <LinearLayout
        android:id="@+id/layoutPositions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblCourtPosition">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDrive"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/filter_pos_drive"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:strokeColor="@color/grey_bg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackhand"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:text="@string/filter_pos_backhand"
            android:textColor="@color/green"
            app:cornerRadius="8dp"
            app:strokeColor="@color/green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnyPos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/filter_pos_any"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            app:strokeColor="@color/grey_bg" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblAvailability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/filter_availability"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPositions" />

    <RadioGroup
        android:id="@+id/radioGroupAvailability"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblAvailability">

        <RadioButton
            android:id="@+id/radioAllMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/green"
            android:text="@string/filter_all_matches"
            android:textColor="@color/white" />

        <RadioButton
            android:id="@+id/radioOpenSpots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/green"
            android:checked="true"
            android:text="@string/filter_open_spots"
            android:textColor="@color/white" />
    </RadioGroup>


    <TextView
        android:id="@+id/lblSearchDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/filter_search_distance"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/radioGroupAvailability" />

    <TextView
        android:id="@+id/badgeDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/green_level_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/filter_distance_value"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/lblSearchDistance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/lblSearchDistance" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderDistance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:value="15.0"
        android:valueFrom="1.0"
        android:valueTo="50.0"
        app:haloColor="@color/green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblSearchDistance"
        app:thumbColor="@color/green"
        app:trackColor="@color/grey_bg"
        app:trackColorActive="@color/green" />

    <TextView
        android:id="@+id/lblMinDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filter_min_distance"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sliderDistance" />

    <TextView
        android:id="@+id/lblMaxDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/filter_max_distance"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sliderDistance" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/grey_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblMinDistance" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/filter_btn_apply"
        android:textColor="@color/backBlack"
        android:textStyle="bold"
        app:backgroundTint="@color/green"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <TextView
        android:id="@+id/btnResetFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"

        android:clickable="true"
        android:focusable="true"
        android:text="@string/filter_btn_reset"
        android:textColor="@color/green"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnApplyFilters" />

</androidx.constraintlayout.widget.ConstraintLayout>